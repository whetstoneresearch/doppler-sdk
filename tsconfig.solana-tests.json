{
  "extends": "./tsconfig.json",
  "include": ["test/solana/**/*.ts", "test/solana/**/*.tsx", "vitest.solana.config.ts"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,

# Doppler SDK Examples Configuration

# Your wallet private key (keep this secret!)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# RPC endpoint for your target chain
# Base Mainnet
RPC_URL=https://mainnet.base.org

# Multicurve fee examples
# Set ASSET_ADDRESS to one launched multicurve token for fee collection.
# Set ASSET_ADDRESSES to a comma-separated list for multi-token fee previews.
# ASSET_ADDRESS=0xYOUR_ASSET_ADDRESS_HERE
# ASSET_ADDRESSES=0xASSET_ADDRESS_1,0xASSET_ADDRESS_2
# BENEFICIARY_ADDRESS=0xBENEFICIARY_ADDRESS
# PENDING_FEES_TOKEN_BATCH_SIZE=25

# Base mainnet safety guard (used by decay base-mainnet examples)
# CONFIRM_BASE_MAINNET=true
# Optional launch-script toggle:
# If true, examples/multicurve-decay-base-mainnet-launch.ts broadcasts;
# if false/omitted, that script runs simulation-only mode.
# EXECUTE_MAINNET=false

# Alternative RPC endpoints:
# Base Sepolia Testnet
# RPC_URL=https://sepolia.base.org
# Required opt-in for examples/multicurve-custom-executor.ts to broadcast.
# Without this exact value, the example prepares but does not submit.
# EXECUTE_TRANSACTION=true

# Ethereum Mainnet
# RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Custom RPC
# RPC_URL=https://your-custom-rpc-endpoint.com

# Solana examples
# Explicit network selector: devnet or custom.
# Most checked-in Solana examples target the current Doppler devnet deployment.
# SOLANA_NETWORK=devnet
# SOLANA_KEYPAIR_PATH=/path/to/solana-keypair.json
# SOLANA_KEYPAIR=[1,2,...64 byte secret key JSON array]
# Optional endpoint overrides. Required when SOLANA_NETWORK=custom.
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_WS_URL=wss://api.devnet.solana.com
# Required when SOLANA_NETWORK=custom:
# SOLANA_CPMM_PROGRAM_ID=CPMM_PROGRAM_ID
# SOLANA_INITIALIZER_PROGRAM_ID=INITIALIZER_PROGRAM_ID
# SOLANA_CPMM_MIGRATOR_PROGRAM_ID=CPMM_MIGRATOR_PROGRAM_ID
# SOLANA_DOPPLER_LAUNCH_HOOK_V1_PROGRAM_ID=DOPPLER_LAUNCH_HOOK_V1_PROGRAM_ID
# SOLANA_DOPPLER_LAUNCH_HOOK_V2_PROGRAM_ID=DOPPLER_LAUNCH_HOOK_V2_PROGRAM_ID
# SOLANA_DOPPLER_REHYPE_ROUTER_V1_PROGRAM_ID=DOPPLER_REHYPE_ROUTER_V1_PROGRAM_ID
# SOLANA_VESTING_PROGRAM_ID=DOPPLER_VESTING_PROGRAM_ID
# Advanced launch: optional feature inputs (defaults shown).
# SOLANA_QUOTE=sol
# SOLANA_BASE_TOKEN_PROGRAM=spl
# USDC requires a funded quote ATA; custom deployments must specify their mint.
# SOLANA_USDC_MINT=USDC_MINT
# SOL_PRICE_USD=150
# SOLANA_VESTING_CLIFF_SECONDS=604800
# SOLANA_VESTING_DURATION_SECONDS=2592000
# SOLANA_DYNAMIC_FEE_DURATION_SECONDS=600
# Supplying this key enables cosigning; it must match the managed hook signer.
# COSIGNER_KEYPAIR_PATH=/path/to/cosigner-keypair.json
# Inputs for solana-advanced-launch.ts claim:
# SOLANA_VESTING_LAUNCH=LAUNCH_ACCOUNT
# SOLANA_VESTING_BASE_MINT=BASE_MINT
# SOLANA_VESTING_BENEFICIARY=BENEFICIARY_WALLET

# Spot pool: payer must hold the base tokens. Amounts are raw token units.
# SPOT_POOL_BASE_MINT=TOKEN_MINT
# SPOT_POOL_BASE_AMOUNT=1000000
# SPOT_POOL_QUOTE_AMOUNT=10000000
# Optional: defaults to WSOL and SPL Token.
# SPOT_POOL_QUOTE_MINT=QUOTE_MINT
# SPOT_POOL_BASE_TOKEN_PROGRAM=spl
# SPOT_POOL_SWAP_FEE_BPS=30
# Optional creation hook; automatic swap is skipped when supplied.
# Hook flags: 1=before swap, 2=after swap, 3=both.
# SPOT_POOL_HOOK_PROGRAM=HOOK_PROGRAM_ID
# SPOT_POOL_HOOK_FLAGS=1

# Fee routing: asset, numeraire, inKind, or balanced.
# SOLANA_FEE_REHYPOTHECATION_STRATEGY=numeraire
# SOLANA_FEE_REHYPOTHECATION_SETTLE_AND_CLAIM=true
# Inputs for solana-fee-routing.ts settle:
# SOLANA_LAUNCH=LAUNCH_ACCOUNT
# SOLANA_BASE_MINT=BASE_MINT
# SOLANA_FEE_BENEFICIARY=BENEFICIARY_WALLET

# Prediction: create prints addresses; buy/resolve/claim use these inputs.
# SOLANA_PREDICTION_STATE_OUTPUT=prediction-state.json
# SOLANA_PREDICTION_MARKET=MARKET_ACCOUNT
# SOLANA_PREDICTION_BASE_MINT=OUTCOME_MINT
# SOLANA_PREDICTION_AMOUNT_IN=10000000
# SOLANA_PREDICTION_WINNER_INDEX=0
# SOLANA_PREDICTION_BURN_AMOUNT=1000000

# Doppler SDK Examples Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required: Your wallet private key (keep this secret!)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# RPC endpoint for your target chain
RPC_URL=https://mainnet.base.org

# Doppler indexer endpoint (for multicurve-indexer-data example)
# INDEXER_URL=https://testnet-indexer.doppler.lol/

# Optional: Pool/token addresses for specific examples
# POOL_ADDRESS=0xYOUR_POOL_ADDRESS_HERE
# ASSET_ADDRESS=0xYOUR_ASSET_ADDRESS_HERE
# TOKEN_ADDRESS=0xYOUR_TOKEN_ADDRESS_HERE
# SPENDER=0xYOUR_SPENDER_ADDRESS_HERE

# Optional: For auction-monitoring example
# STATIC_POOL_ADDRESS=0xYOUR_STATIC_POOL_ADDRESS_HERE
# DYNAMIC_HOOK_ADDRESS=0xYOUR_DYNAMIC_HOOK_ADDRESS_HERE

# Optional: For multicurve fees live tests
# PENDING_FEES_LIVE_CHAIN_ID=8453
# PENDING_FEES_LIVE_ASSET=0x4200000000000000000000000000000000000006
# PENDING_FEES_LIVE_BENEFICIARY=0x0000000000000000000000000000000000000000
